{
  "enabled": true,
  "telemetry": false,
  "checkpoints": {
    "primary": {
      "type": "git-refs"
    }
  },
  "redaction": {
    "pii": {
      "enabled": true,
      "email": true,
      "phone": true,
      "address": false
    },
    "custom_redactions": {
      "password_assignment": "(?i)(password|passwd|pwd|пароль)[\"']?\\s*[:=]\\s*[\"']?[^\\s\"',;]{4,}",
      "bcrypt_hash": "\\$2[aby]\\$[0-9]{2}\\$[./A-Za-z0-9]{53}",
      "proxy_link": "(?i)\\b(vless|vmess|trojan|hysteria2?|ss)://[^\\s\"'<>]+",
      "private_key": "-----BEGIN [A-Z ]*PRIVATE KEY-----[\\s\\S]*?-----END [A-Z ]*PRIVATE KEY-----",
      "telegram_bot_token": "\\b[0-9]{8,10}:[A-Za-z0-9_-]{35}\\b"
    }
  }
}
